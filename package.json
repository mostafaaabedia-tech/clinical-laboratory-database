{
  "name": "clinical-laboratory-database",
  "productName": "Clinical Laboratory System",
  "version": "1.1.0",
  "description": "Desktop Laboratory Information System (LIS) with a full SQLite database: reception, results, reports, test catalog & prices, sales charts, finance, inventory.",
  "main": "main.js",
  "author": "Mostafa Mesbah Aabedi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/db-selftest.js",
    "ui-test": "electron scripts/shots.js",
    "export-db": "node scripts/export-schema.js",
    "update-vendor": "node scripts/update-vendor.js",
    "build:win": "electron-builder --win nsis portable --publish never",
    "build:linux": "electron-builder --linux AppImage --publish never",
    "build:mac": "electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "sql.js": "^1.15.0"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^26.0.0",
    "chart.js": "^4.5.1",
    "@fontsource/vazirmatn": "^5.3.0"
  },
  "build": {
    "appId": "af.lab.clinical-laboratory-system",
    "productName": "Clinical Laboratory System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "database/schema.sql",
      "node_modules/sql.js/dist/sql-wasm.js",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/sql.js/package.json",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Clinical Laboratory System",
      "artifactName": "ClinicalLab-Setup-${version}-${arch}.exe"
    },
    "portable": {
      "artifactName": "ClinicalLab-Portable-${version}-${arch}.exe"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg"
      ]
    }
  },
  "homepage": "https://github.com/mostafaaabedia-tech/clinical-laboratory-database",
  "repository": {
    "type": "git",
    "url": "https://github.com/mostafaaabedia-tech/clinical-laboratory-database.git"
  }
}
